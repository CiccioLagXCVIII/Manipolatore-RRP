{
    // AA Configurazione Dei Percorsi Di Ricerca Per Il Completamento Automatico Di Python
    "python.analysis.extraPaths": [
        "/opt/ros/noetic/lib/python3/dist-packages",
        "/root/catkin_ws/devel/lib/python3/dist-packages",
        "${workspaceFolder}",
        "${workspaceFolder}/src",
        "${workspaceFolder}/scripts"
    ],
    // BB Abilita Il Completamento Automatico Dei Messaggi E Dei Servizi Di ROS Noetic
    "python.autoComplete.extraPaths": [
        "/opt/ros/noetic/lib/python3/dist-packages",
        "/root/catkin_ws/devel/lib/python3/dist-packages",
        "${workspaceFolder}",
        "${workspaceFolder}/src",
        "${workspaceFolder}/scripts"
    ],
    // AA Configurazione Dei Livelli Di Severità Di Pylance Per NumPy
    "python.analysis.diagnosticSeverityOverrides": {
        "reportAttributeAccessIssue": "none",
        "reportGeneralTypeIssues": "none",
        "reportOperatorIssue": "none"
    },
    // BB Abilitazione Della Ricerca Dei Tipi Nelle Librerie Esterne
    "python.analysis.useLibraryCodeForTypes": true,
    // BB Disattivazione Del Controllo Rigido Dei Tipi Per Ambienti Dinamici Come ROS
    "python.analysis.typeCheckingMode": "off",
    // AA Configurazione Delle Associazioni Dei File Per ROS Noetic
    "files.associations": {
        "*.launch": "xml",
        "*.urdf": "xml",
        "*.xacro": "xml",
        "*.msg": "msg",
        "*.srv": "srv",
        "*.action": "action"
    },
    // AA Igiene E Pulizia Automatica Del Codice Al Salvataggio
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    // AA Configurazione Di C++ IntelliSense Per I Pacchetti Di ROS
    "C_Cpp.default.includePath": [
        "/opt/ros/noetic/include/**",
        "/root/catkin_ws/devel/include/**",
        "${workspaceFolder}/src/**"
    ],
    // BB Riduzione Spessore Divisori A 1px E Disattivazione Layout Moderno Spesso
    "workbench.sash.size": 1,
    "workbench.experimental.modernUI": false,
    // AA Configurazione Estetica Colori E Bordi Di VS Code
    "workbench.colorCustomizations": {
        "panelSection.border": "#00000000",
        "terminal.border": "#00000000",
        "editorPane.border": "#00000000",
        "activityBar.border": "#00000000",
        "sash.hoverBorder": "#ff6b1a",
        "commandCenter.border": "#e7e7e799",
        "statusBar.background": "#e65100",
        "statusBar.foreground": "#e7e7e7",
        "statusBarItem.hoverBackground": "#ff6b1a",
        "statusBarItem.remoteBackground": "#006022",
        "statusBarItem.remoteForeground": "#e7e7e7",
        "titleBar.activeBackground": "#e65100",
        "titleBar.activeForeground": "#e7e7e7",
        "titleBar.inactiveBackground": "#e6510099",
        "titleBar.inactiveForeground": "#e7e7e799",
        "commandCenter.foreground": "#e7e7e7",
        "statusBar.debuggingBackground": "#e65100",
        "statusBar.debuggingForeground": "#e7e7e7"
    },
    // BB Disattivazione Bordi Peacock Per Sidebar Ed Editor
    "peacock.affectActivityBar": false,
    "peacock.affectSideBarBorder": false,
    "peacock.affectEditorGroupBorder": false,
    "peacock.affectPanelBorder": false,
    "peacock.remoteColor": "#e65100",
    // AA Configurazione Dei Tag E Colori Per Better Comments
    "better-comments.tags": [
        {
            "tag": "AA",
            "color": "#FFD700",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "BB",
            "color": "#00E5FF",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "CC",
            "color": "#69F0AE",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "DD",
            "color": "#FF7043",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "EE",
            "color": "#FF80BF",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        }
    ],
    // AA Configurazione Per Sviluppo Remoto In Docker
    "remote.extensionKind": {
        "fabiospampinato.vscode-commands": [
            "workspace"
        ]
    },
    // AA Configurazione Di Pulsanti Nella Barra Di Stato
    "commands.commands": [
        {
            "text": "$(play) ROS Terminals",
            "tooltip": "Avvia I Terminali Di ROS",
            "command": "terminals.runTerminals",
            "alignment": "left",
            "priority": 100
        }
    ]
}
